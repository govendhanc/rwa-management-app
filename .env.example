# =====================================================================
#  ROWA Portal - environment configuration
#  Copy this file to ".env" and adjust. NEVER commit .env to version control.
#  Real server environment variables (SetEnv / fastcgi_param) override this file.
# =====================================================================

# development | testing | production
APP_ENV=production

# Full URL to the "public" folder, with trailing slash
APP_URL=https://portal.example.com/
APP_TIMEZONE=Asia/Kolkata

# 64 hex characters. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_ENCRYPTION_KEY=

# true when the site is served over HTTPS (secure cookies)
APP_FORCE_HTTPS=true

# 0 = off, 1 = errors, 2 = debug, 3 = info, 4 = all
APP_LOG_THRESHOLD=1

# Comma separated reverse proxy IPs (leave blank if none)
APP_PROXY_IPS=

# ---------------- Database ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=rowa_user
DB_PASSWORD=
DB_DATABASE=rowa_portal

# ---------------- E-mail (forgot password) ----------------
# protocol: mail | smtp | sendmail | log (log = write e-mails to storage/logs, for development)
MAIL_PROTOCOL=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls | ssl | (blank)
MAIL_CRYPTO=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="ROWA Portal"

# ---------------- WhatsApp Cloud API (only when whatsapp_mode = cloud_api) ----------------
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Optional, leave blank in production (only for testing against a mock server or using a proxy)
WHATSAPP_CLOUD_BASE_URL=

# ---------------- Database backup ----------------
# Full path to mysqldump (optional). If blank or not executable, a PHP-based dump is used.
MYSQLDUMP_PATH=
